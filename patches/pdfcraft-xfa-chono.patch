+/// `xfa.resolveNode("xfa.datasets")` is the datasets node: a form's Clear button walks its
+/// nodes and removes the groups the form added (Canada's IMM 5710 stopped with "cannot convert
+/// null to object" there).
+#[test]
+fn resolve_node_gives_the_datasets_node() {
+    let template = r##"<?xml version="1.0" encoding="UTF-8"?>
+<xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/">
+<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
+<subform name="form" layout="tb">
