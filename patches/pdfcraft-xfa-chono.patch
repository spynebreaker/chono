+/// The code of the script object standing for a named value: its text as `value`, which scripts read and set.
+pub fn named_value_code(value: &str) -> String {
+    let mut code = String::with_capacity(value.len() + 64);
+    code.push_str(NAMED_VALUE_MARKER);
+    code.push_str("var value = \"");
+    for c in value.chars() {
+        match c {
+            '"' => code.push_str("\\\""),
+            '\\' => code.push_str("\\\\"),
+            '\n' => code.push_str("\\n"),
+            '\r' => code.push_str("\\r"),
+            c if (c as u32) < 0x20 || c == '\u{2028}' || c == '\u{2029}' => code.push_str(&format!("\\u{:04x}", c as u32)),
+            c => code.push(c),
