+//! Barcode symbols for `<ui><barcode>` fields. PDF417 (ISO/IEC 15438) is encoded with the vendored
+//! `pdf417` crate; every size it is given is checked here first, because it asserts on bad ones.
+
+/// A symbol as rows of modules: `true` is a dark module.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Symbol {
+    /// Modules per row.
+    pub width: usize,
+    /// Rows; each is drawn one row height tall.
+    pub rows: usize,
+    /// `rows * width` modules, row after row.
+    pub modules: Vec<bool>,
+}
+
+impl Symbol {
+    /// The dark runs of row `r`: (first module, length).
+    pub fn runs(&self, r: usize) -> Vec<(usize, usize)> {
+        let row = self.modules.get(r * self.width..(r + 1) * self.width).unwrap_or(&[]);
+        let mut out = vec![];
+        let mut start = None;
+        for (i, on) in row.iter().chain(std::iter::once(&false)).enumerate() {
+            match (*on, start) {
+                (true, None) => start = Some(i),
+                (false, Some(s)) => {
+                    out.push((s, i - s));
+                    start = None;
+                }
+                _ => {}
+            }
+        }
+        out
+    }
+}
+
+/// The most codewords one PDF417 symbol holds (data, length and error correction).
+const MAX_CODEWORDS: usize = 928;
+/// Text longer than this can't fit one symbol however it compacts; it is not encoded.
+const MAX_TEXT: usize = 2800;
+/// Modules of a row other than its data columns: start, left and right indicators, stop.
+const ROW_OVERHEAD: usize = 17 + 17 + 17 + 18;
+
+/// Codewords `text` takes before error correction, the length codeword included.
+fn data_codewords(text: &str) -> Option<usize> {
+    // Text compaction never takes more than two codewords a character; byte compaction less.
+    let mut scratch = vec![0u16; text.len().checked_mul(2)?.checked_add(16)?];
+    let enc = pdf417::PDF417Encoder::new(&mut scratch, false);
+    let enc = if text.is_ascii() { enc.append_ascii(text) } else { enc.append_utf8(text) };
+    Some(enc.count())
+}
+
+/// A PDF417 symbol for `text` at error correction `level` (lowered when the text needs the room),
+/// with the number of data columns that best fills a `w` by `h` box drawn with modules
+/// `module_w` wide and rows `row_h` tall. `None` when the text doesn't fit one symbol.
+pub fn pdf417(text: &str, level: u8, w: f64, h: f64, module_w: f64, row_h: f64) -> Option<Symbol> {
+    if text.is_empty() || text.len() > MAX_TEXT || !(module_w > 0.0 && row_h > 0.0) {
+        return None;
+    }
+    let data = data_codewords(text)?;
+    let mut level = level.min(8);
+    while data + pdf417::ecc::ecc_count(level) > MAX_CODEWORDS {
+        level = level.checked_sub(1)?;
+    }
+    let total = data + pdf417::ecc::ecc_count(level);
+    // The columns whose symbol is drawn largest in the box (ties go to fewer columns).
+    let mut best: Option<(f64, usize, usize)> = None;
+    for cols in usize::from(pdf417::MIN_COLS)..=usize::from(pdf417::MAX_COLS) {
+        let rows = total.div_ceil(cols).max(usize::from(pdf417::MIN_ROWS));
+        if rows > usize::from(pdf417::MAX_ROWS) {
+            continue;
+        }
+        let sw = (ROW_OVERHEAD + 17 * cols) as f64 * module_w;
+        let sh = rows as f64 * row_h;
+        let scale = (w / sw).min(h / sh);
+        if best.is_none_or(|(s, ..)| scale > s + 1e-9) {
+            best = Some((scale, cols, rows));
+        }
+    }
+    let (_, cols, rows) = best?;
+    let mut codewords = vec![0u16; rows * cols];
+    let enc = pdf417::PDF417Encoder::new(&mut codewords, false);
+    let enc = if text.is_ascii() { enc.append_ascii(text) } else { enc.append_utf8(text) };
+    if enc.count() != data {
+        return None;
+    }
+    enc.seal(level);
+    let width = ROW_OVERHEAD + 17 * cols;
+    let mut modules = vec![false; width * rows];
+    // Both fit the crate's limits (checked above), and `codewords` is `rows * cols` long.
+    pdf417::PDF417::new(&codewords, u8::try_from(rows).ok()?, u8::try_from(cols).ok()?, level).render(&mut modules[..]);
+    Some(Symbol { width, rows, modules })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_short_text_makes_a_symbol_that_starts_and_stops_every_row() {
+        let s = pdf417("IMM5257|Doe|John|1980-01-01", 5, 270.0, 144.0, 0.958, 1.916).expect("encodes");
+        assert_eq!(s.modules.len(), s.width * s.rows);
+        assert!(s.rows >= 3);
+        // Every row opens with the start pattern: eight dark modules.
+        for r in 0..s.rows {
+            assert_eq!(s.runs(r).first(), Some(&(0, 8)), "row {r}");
+        }
+    }
+
+    #[test]
+    fn text_too_long_or_empty_is_refused_without_a_panic() {
+        assert_eq!(pdf417("", 5, 100.0, 100.0, 1.0, 2.0), None);
+        assert_eq!(pdf417(&"x".repeat(MAX_TEXT + 1), 5, 100.0, 100.0, 1.0, 2.0), None);
+        assert_eq!(pdf417("abc", 5, 100.0, 100.0, 0.0, 2.0), None);
+        // Long enough to need a lower error correction level, then too long for any.
+        assert!(pdf417(&"ABCD".repeat(250), 8, 300.0, 300.0, 1.0, 2.0).is_some());
+        assert_eq!(pdf417(&"\u{e9}".repeat(1400), 0, 300.0, 300.0, 1.0, 2.0), None);
+    }
+}
+
+#[cfg(test)]
