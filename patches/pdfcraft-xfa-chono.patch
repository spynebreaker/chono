+//! A choice list's methods and members (XFA 3.3 field object: `addItem`, `clearItems`, `deleteItem`, `getDisplayItem`,
+//! `getSaveItem`, `boundItem`, `length`, `selectedIndex`). Forms fill lists from their data this way (an IRCC form's
+//! provinces follow the country chosen). The lists a script leaves are recorded as one effect per field, replacing the
+//! last one, and kept in the snapshot so the rest of the script reads them.
+
+use boa_engine::{Context, JsObject, JsResult, JsString, JsValue, NativeFunction};
+
+use super::host::{XHost, host};
+use super::model::{XfaEffect, XfaKind};
