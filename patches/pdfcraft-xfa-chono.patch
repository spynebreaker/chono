+/// A click script that paints a field's widget border (edge by edge, as validation scripts mark
+/// a missing answer) changes the widget's border colour; taking the border out again restores it.
+#[test]
+fn xfa_scripts_paint_and_clear_a_field_border() {
+    let template = r##"<?xml version="1.0" encoding="UTF-8"?>
+<xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/">
+<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
+<subform name="form" layout="tb">
+ <pageSet><pageArea name="front"><contentArea x="0.5in" y="0.5in" w="7.5in" h="10in"/><medium short="8.5in" long="11in"/></pageArea></pageSet>
+ <subform name="page" layout="tb">
+  <field name="name" w="2in" h="0.3in"><ui><textEdit/></ui></field>
+  <exclGroup name="answer" layout="lr-tb">
+   <field name="Yes" w="0.5in" h="0.3in"><ui><checkButton shape="round"/></ui><items><integer>1</integer></items></field>
+   <field name="No" w="0.5in" h="0.3in"><ui><checkButton shape="round"/></ui><items><integer>2</integer></items></field>
+  </exclGroup>
+  <field name="mark" w="1in" h="0.3in"><ui><button/></ui>
+   <event activity="click"><script contentType="application/x-javascript">
+    var targets = [name, answer.Yes];
+    for (var t = 0; t &lt; targets.length; t++) {
+     var b = targets[t].ui.oneOfChild.border;
+     b.presence = "visible";
+     for (var i = 0; i &lt; 4; i++) { var e = b.getElement("edge", i); e.presence = "visible"; e.color.value = "232, 6, 6"; e.thickness = "2pt"; }
+    }
+   </script></event>
+  </field>
+  <field name="clear" w="1in" h="0.3in"><ui><button/></ui>
+   <event activity="click"><script contentType="application/x-javascript">
+    var b = name.ui.oneOfChild.border; b.parent.nodes.remove(b);
+   </script></event>
+  </field>
+ </subform>
+</subform>
+</template>
+</xdp:xdp>
+"##;
+    let bytes = Arc::new(pdfcraft_xfa::fixtures::shell(template));
+    let mut s = Session::new().with_clock(|| 1_700_000_000);
+    let id = s.open("border.pdf", None, bytes, None).expect("opens");
+    let red = |s: &Session, n: &str| {
+        let cos = pdfcraft_cos::Document::open(s.get(id).unwrap().bytes.clone()).expect("reopens");
+        let f = s.get(id).unwrap().form.iter().find(|f| f.name == n).cloned().unwrap_or_else(|| panic!("no field {n}"));
+        let field = cos.get(f.obj);
+        let mut widgets = vec![field.clone()];
+        if let Some(kids) = field.as_dict().and_then(|d| d.get(b"Kids")).and_then(|k| k.as_array()) {
+            widgets = kids.iter().map(|k| cos.resolve(k)).collect();
+        }
+        widgets.iter().any(|w| {
+            let bc = w.as_dict().and_then(|d| d.get(b"MK")).map(|m| cos.resolve(m));
+            let bc = bc
+                .as_ref()
+                .and_then(|m| m.as_dict())
+                .and_then(|m| m.get(b"BC"))
+                .and_then(|b| b.as_array())
+                .map(|a| a.iter().filter_map(|v| v.as_f64()).collect::<Vec<_>>());
+            bc.is_some_and(|c| c.len() == 3 && c[0] > 0.85 && c[1] < 0.1 && c[2] < 0.1)
+        })
+    };
+    assert!(!red(&s, "name") && !red(&s, "answer"), "no red border before the click");
+    let out = s.run_javascript(id, "", Some("mark")).unwrap();
+    assert_eq!(out.error, None, "{out:?}");
+    assert!(red(&s, "name"), "the text field is marked");
+    assert!(red(&s, "answer"), "the radio button is marked");
+    let out = s.run_javascript(id, "", Some("clear")).unwrap();
+    assert_eq!(out.error, None, "{out:?}");
+    assert!(!red(&s, "name"), "the border is taken out again");
+    assert!(red(&s, "answer"), "the other mark stays");
+}
