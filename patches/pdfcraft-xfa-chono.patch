+/// A static XFA form (its own pages and AcroForm fields, nothing laid out) runs its template's
+/// scripts on its own fields: a push button's click alerts, paints a field's border, hides one
+/// field and makes another read-only; ticking one check box runs its click script, which clears
+/// the other; choosing a radio button runs its click script; a page-master button, whose AcroForm name has two more steps than its script
+/// object's, runs its own script.
+#[test]
+fn static_xfa_forms_run_their_scripts_on_their_own_fields() {
+    let bytes = Arc::new(pdfcraft_xfa::fixtures::static_scripted_shell());
+    let mut s = Session::new().with_clock(|| 1_700_000_000);
+    let id = s.open("static.pdf", None, bytes, None).expect("opens");
+    assert_eq!(s.get(id).unwrap().info.xfa, Some(pdfcraft_render::Xfa::Static));
+    assert!(s.get(id).unwrap().xfa.is_none(), "nothing was laid out");
+    let n = |f: &str| format!("form1[0].page1[0].{f}[0]");
+    let field = |s: &Session, f: &str| s.get(id).unwrap().form.iter().find(|x| x.name == f).cloned().unwrap_or_else(|| panic!("no field {f}"));
+    let widget = |s: &Session, f: &str| {
+        let cos = pdfcraft_cos::Document::open(s.get(id).unwrap().bytes.clone()).expect("reopens");
+        let r = field(s, f).obj;
+        cos.get(r).as_dict().cloned().expect("a dict")
+    };
+    for b in [n("check"), "form1[0].master[0].front[0].stamp[0]".to_string()] {
+        assert!(field(&s, &b).button.is_some(), "{b} is marked as running a script");
+    }
+    // Ticking one box clears the other.
+    s.apply(id, Edit::SetFieldValue { name: n("worker"), value: FieldValue::Check(true) }).unwrap();
+    assert_eq!(field(&s, &n("worker")).value, vec!["1".to_string()]);
+    s.apply(id, Edit::SetFieldValue { name: n("visitor"), value: FieldValue::Check(true) }).unwrap();
+    assert_eq!(field(&s, &n("visitor")).value, vec!["1".to_string()]);
+    assert_ne!(field(&s, &n("worker")).value, vec!["1".to_string()], "the visitor's script cleared the worker");
+    // The check: name is empty.
+    let out = s.run_javascript(id, "", Some(&n("check"))).unwrap();
+    assert_eq!(out.error, None, "{out:?}");
+    assert_eq!(out.alerts.len(), 1, "{:?}", out.alerts);
+    assert!(format!("{:?}", out.alerts[0]).contains("Name is required"));
+    let name = widget(&s, &n("name"));
+    let cos = pdfcraft_cos::Document::open(s.get(id).unwrap().bytes.clone()).unwrap();
+    let bc: Vec<f64> = name
+        .get(b"MK")
+        .map(|m| cos.resolve(m))
+        .and_then(|m| m.as_dict().and_then(|m| m.get(b"BC")).and_then(|b| b.as_array()).map(|a| a.iter().filter_map(|v| v.as_f64()).collect()))
+        .unwrap_or_default();
+    assert!(bc.len() == 3 && bc[0] > 0.9 && bc[1] < 0.1 && bc[2] < 0.1, "red border: {bc:?}");
+    let flag = |d: &pdfcraft_cos::Dict, k: &[u8]| d.get(k).and_then(|v| v.as_int()).unwrap_or(0);
+    assert_ne!(flag(&widget(&s, &n("worker")), b"F") & 2, 0, "worker is hidden");
+    assert_ne!(flag(&widget(&s, &n("visitor")), b"Ff") & 1, 0, "visitor is read-only");
+    assert_eq!(flag(&widget(&s, &n("name")), b"F") & 2, 0, "name stays visible");
+    // Choosing a radio button runs that button's click script.
+    for (pos, said) in [(1, "french"), (0, "english")] {
+        s.apply(id, Edit::SetFieldValue { name: n("lang"), value: FieldValue::Widget(pos) }).unwrap();
+        assert!(s.take_js_output(id).errors.is_empty());
+        assert_eq!(field(&s, &n("said")).value, vec![said.to_string()], "button {pos}");
+    }
+    // The page-master button.
+    let out = s.run_javascript(id, "", Some("form1[0].master[0].front[0].stamp[0]")).unwrap();
+    assert_eq!(out.error, None, "{out:?}");
+    assert_eq!(field(&s, &n("name")).value, vec!["stamped".to_string()]);
+    // The values are written to the datasets on saving.
+    let saved = s.save_bytes(id).unwrap();
+    let cos = pdfcraft_cos::Document::open(saved).unwrap();
+    let data = pdfcraft_xfa::parse_datasets(&pdfcraft_xfa::read_packets(&cos).unwrap().unwrap().xdp).unwrap();
+    assert_eq!(data.text_at(&pdfcraft_xfa::som_to_path(&n("name"))), Some("stamped"));
+}
