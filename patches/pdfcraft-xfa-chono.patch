+/// What a static form's scripts changed, on its own fields (it isn't laid out again): an
+/// object hidden or shown (the fields under it too), made read-only or open, its border
+/// colour, its list's items. Returns notes on what couldn't be applied.
+fn apply_static_overrides(
+    doc: &mut pdfcraft_cos::Document,
+    ov: &pdfcraft_xfa::Overrides,
+    by_som: &HashMap<String, (String, pdfcraft_cos::ObjRef)>,
+) -> Result<Vec<String>, String> {
+    use pdfcraft_cos::Object;
+    let under = |som: &str, target: &str| som == target || som.strip_prefix(target).is_some_and(|rest| rest.starts_with('.'));
+    let mut touched: HashSet<String> = HashSet::new();
+    let notes = Vec::new();
+    // Widget dictionaries of a field: its kids, or itself.
+    let widgets_of = |doc: &pdfcraft_cos::Document, r: pdfcraft_cos::ObjRef| -> Vec<pdfcraft_cos::ObjRef> {
+        let o = doc.get(r);
+        let kids: Vec<pdfcraft_cos::ObjRef> = o
+            .as_dict()
+            .and_then(|d| d.get(b"Kids"))
+            .map(|k| doc.resolve(k))
+            .and_then(|k| k.as_array().map(|a| a.iter().filter_map(Object::as_ref).collect()))
+            .unwrap_or_default();
+        if kids.is_empty() { vec![r] } else { kids }
+    };
+    let set_int = |doc: &mut pdfcraft_cos::Document, r: pdfcraft_cos::ObjRef, key: &[u8], f: &dyn Fn(i64) -> i64| -> Result<(), String> {
+        let mut d = doc.get(r).as_dict().cloned().ok_or("not a dictionary")?;
+        let old = d.int(key).unwrap_or(0);
+        let new = f(old);
+        if new != old {
+            d.set(key.to_vec(), Object::Int(new));
+            doc.set(r, Object::Dict(d));
+        }
+        Ok(())
+    };
+    for (som, (name, r)) in by_som {
+        // The nearest override on the field or a container of it wins (a field shown inside a
+        // hidden section stays hidden: the section's presence covers it).
+        let presence =
+            ov.presence.iter().filter(|(t, _)| under(som, t)).map(|(t, p)| (t.len(), p.as_str())).fold(None::<(usize, &str)>, |best, (len, p)| {
+                match best {
+                    Some((bl, bp)) if bl >= len && (bp != "visible" || p == "visible") => Some((bl, bp)),
+                    _ => Some((len, p)),
+                }
+            });
+        // A container's hidden presence covers what it holds, whatever their own says.
+        let hidden_by_container = ov.presence.iter().any(|(t, p)| t != som && under(som, t) && p != "visible");
+        if let Some((_, p)) = presence {
+            let hide = hidden_by_container || p != "visible";
+            for w in widgets_of(doc, *r) {
+                // Annotation flags (ISO 32000-2 Table 167): Hidden 2, Print 4.
+                set_int(doc, w, b"F", &|f| if hide { (f | 2) & !4 } else { (f & !2) | 4 })?;
+            }
+            touched.insert(name.clone());
+        }
+        if let Some((_, a)) = ov.access.iter().filter(|(t, _)| under(som, t)).max_by_key(|(t, _)| t.len()) {
+            let lock = matches!(a.as_str(), "readOnly" | "protected" | "nonInteractive");
+            // Field flag ReadOnly, bit 1 (ISO 32000-2 Table 226).
+            set_int(doc, *r, b"Ff", &|f| if lock { f | 1 } else { f & !1 })?;
+            touched.insert(name.clone());
+        }
+        if let Some((color, width)) = ov.borders.get(som) {
+            for w in widgets_of(doc, *r) {
+                let mut d = doc.get(w).as_dict().cloned().ok_or("not a dictionary")?;
+                let mut mk = d.get(b"MK").map(|m| doc.resolve(m)).and_then(|m| m.as_dict().cloned()).unwrap_or_default();
+                match pdfcraft_xfa::model::Color::parse(color) {
+                    Some(c) if !color.trim().is_empty() => {
+                        mk.set(b"BC".to_vec(), Object::Array(c.0.iter().map(|v| Object::Real(*v)).collect()));
+                        let mut bs = d.get(b"BS").map(|b| doc.resolve(b)).and_then(|b| b.as_dict().cloned()).unwrap_or_default();
+                        bs.set(b"W".to_vec(), Object::Real(width.max(0.0)));
+                        d.set(b"BS".to_vec(), Object::Dict(bs));
+                    }
+                    _ => {
+                        mk.remove(b"BC");
+                    }
+                }
+                d.set(b"MK".to_vec(), Object::Dict(mk));
+                doc.set(w, Object::Dict(d));
+            }
+            touched.insert(name.clone());
+        }
+    }
+    if !touched.is_empty() {
+        pdfcraft_forms::redraw_fields(doc, |_, f| touched.contains(&f.name)).map_err(|e| e.to_string())?;
+    }
+    Ok(notes)
+}
