diff --git a/crates/js/src/xfa/choice.rs b/crates/js/src/xfa/choice.rs
new file mode 100644
index 00000000..ad60195c
--- /dev/null
+++ b/crates/js/src/xfa/choice.rs
@@ -0,0 +1,153 @@
+//! A choice list's methods and members (XFA 3.3 field object: `addItem`, `clearItems`, `deleteItem`, `getDisplayItem`,
+//! `getSaveItem`, `boundItem`, `length`, `selectedIndex`). Forms fill lists from their data this way (an IRCC form's
+//! provinces follow the country chosen). The lists a script leaves are recorded as one effect per field, replacing the
+//! last one, and kept in the snapshot so the rest of the script reads them.
+
+use boa_engine::{Context, JsObject, JsResult, JsString, JsValue, NativeFunction};
+
+use super::host::{XHost, host};
+use super::model::{XfaEffect, XfaKind};
+use super::props::{ItemList, list_entries, prop_ref};
+use crate::{arg, function, text};
+
+/// The most entries a script may give one list.
+pub const MAX_ITEMS: usize = 20_000;
+
+/// The members this module answers for a field.
+pub(super) const MEMBERS: &[&str] = &["addItem", "clearItems", "deleteItem", "getDisplayItem", "getSaveItem", "boundItem", "length", "selectedIndex"];
+
+/// The list's entries as `(shown, saved)`: the saved list when the field has one, else the shown text saved.
+pub(super) fn entries(h: &XHost, idx: usize) -> Vec<(String, String)> {
+    let shown: Vec<String> = list_entries(h, idx, 0).into_iter().map(|(_, t)| t).collect();
+    let saved: Vec<String> = list_entries(h, idx, 1).into_iter().map(|(_, t)| t).collect();
+    shown.iter().enumerate().map(|(i, d)| (d.clone(), saved.get(i).cloned().unwrap_or_else(|| d.clone()))).collect()
+}
+
+fn set_entries(h: &mut XHost, idx: usize, items: Vec<(String, String)>) {
+    let Some(n) = h.nodes.get(idx) else { return };
+    let som = n.som.to_string();
+    let e = XfaEffect::SetItems { som, items: items.clone() };
+    let bytes = super::model::payload(&e);
+    if !h.reserve(&e, bytes) {
+        return;
+    }
+    if let Some(n) = h.nodes.get_mut(idx) {
+        let lists = vec![
+            ItemList { entries: items.iter().map(|(d, _)| ("text".to_string(), d.clone())).collect() },
+            ItemList { entries: items.iter().map(|(_, s)| ("text".to_string(), s.clone())).collect() },
+        ];
+        n.items = Some(lists);
+    }
+    h.record(e);
+}
+
+fn is_list(h: &XHost, idx: usize) -> bool {
+    h.nodes.get(idx).is_some_and(|n| n.kind == XfaKind::Field)
+}
+
+fn node_of(r: &JsObject, ctx: &mut Context) -> JsResult<usize> {
+    Ok(prop_ref(r, ctx)?.0)
+}
+
+fn add_item(_: &JsValue, args: &[JsValue], r: &JsObject, ctx: &mut Context) -> JsResult<JsValue> {
+    let idx = node_of(r, ctx)?;
+    let shown = text(&arg(args, 0), ctx)?;
+    let saved = if args.len() > 1 && !arg(args, 1).is_undefined() { text(&arg(args, 1), ctx)? } else { shown.clone() };
+    let mut h = host(ctx)?.borrow_mut();
+    if !is_list(&h, idx) {
+        return Ok(JsValue::undefined());
+    }
+    let mut items = entries(&h, idx);
+    if items.len() < MAX_ITEMS {
+        items.push((shown, saved));
+        set_entries(&mut h, idx, items);
+    }
+    Ok(JsValue::undefined())
+}
+
+fn clear_items(_: &JsValue, _: &[JsValue], r: &JsObject, ctx: &mut Context) -> JsResult<JsValue> {
+    let idx = node_of(r, ctx)?;
+    let mut h = host(ctx)?.borrow_mut();
+    if is_list(&h, idx) {
+        set_entries(&mut h, idx, Vec::new());
+    }
+    Ok(JsValue::undefined())
+}
+
+fn delete_item(_: &JsValue, args: &[JsValue], r: &JsObject, ctx: &mut Context) -> JsResult<JsValue> {
+    let idx = node_of(r, ctx)?;
+    let at = arg(args, 0).to_number(ctx)?;
+    let mut h = host(ctx)?.borrow_mut();
+    let mut items = entries(&h, idx);
+    if at.is_finite() && at >= 0.0 && (at as usize) < items.len() {
+        items.remove(at as usize);
+        set_entries(&mut h, idx, items);
+        return Ok(JsValue::from(true));
+    }
+    Ok(JsValue::from(false))
+}
+
+fn item_at(args: &[JsValue], r: &JsObject, ctx: &mut Context, saved: bool) -> JsResult<JsValue> {
+    let idx = node_of(r, ctx)?;
+    let at = arg(args, 0).to_number(ctx)?;
+    let h = host(ctx)?.borrow();
+    let items = entries(&h, idx);
+    if at.is_finite()
+        && at >= 0.0
+        && let Some((d, s)) = items.get(at as usize)
+    {
+        return Ok(JsString::from(if saved { s.as_str() } else { d.as_str() }).into());
+    }
+    Ok(JsValue::null())
+}
+
+fn get_display_item(_: &JsValue, args: &[JsValue], r: &JsObject, ctx: &mut Context) -> JsResult<JsValue> {
+    item_at(args, r, ctx, false)
+}
+
+fn get_save_item(_: &JsValue, args: &[JsValue], r: &JsObject, ctx: &mut Context) -> JsResult<JsValue> {
+    item_at(args, r, ctx, true)
+}
+
+/// `boundItem(shown)`: the value saved for the entry shown as `shown` (the text itself when there is none).
+fn bound_item(_: &JsValue, args: &[JsValue], r: &JsObject, ctx: &mut Context) -> JsResult<JsValue> {
+    let idx = node_of(r, ctx)?;
+    let shown = text(&arg(args, 0), ctx)?;
+    let h = host(ctx)?.borrow();
+    let v = entries(&h, idx).into_iter().find(|(d, _)| *d == shown).map_or(shown, |(_, s)| s);
+    Ok(JsString::from(v.as_str()).into())
+}
+
+/// A member read: the method bound to the field, or `length` / `selectedIndex`; `None` for another name or a node that
+/// isn't a field.
+pub(super) fn get(ctx: &mut Context, idx: usize, key: &str) -> JsResult<Option<JsValue>> {
+    if !is_list(&host(ctx)?.borrow(), idx) || !MEMBERS.contains(&key) {
+        return Ok(None);
+    }
+    let method = |ctx: &mut Context, f: fn(&JsValue, &[JsValue], &JsObject, &mut Context) -> JsResult<JsValue>| -> JsValue {
+        let r = super::props::node_ref(ctx, idx);
+        function(ctx, NativeFunction::from_copy_closure_with_captures(f, r)).into()
+    };
+    Ok(Some(match key {
+        "addItem" => method(ctx, add_item),
+        "clearItems" => method(ctx, clear_items),
+        "deleteItem" => method(ctx, delete_item),
+        "getDisplayItem" => method(ctx, get_display_item),
+        "getSaveItem" => method(ctx, get_save_item),
+        "boundItem" => method(ctx, bound_item),
+        "length" => JsValue::from(entries(&host(ctx)?.borrow(), idx).len() as f64),
+        _ => {
+            let h = host(ctx)?.borrow();
+            let value = h.nodes.get(idx).map(|n| n.value.to_string()).unwrap_or_default();
+            let at = entries(&h, idx).iter().position(|(_, s)| *s == value);
+            JsValue::from(at.map_or(-1.0, |i| i as f64))
+        }
+    }))
+}
+
+/// `selectedIndex = i`: the field takes the saved value of entry `i`; `-1` (or past the end) clears it.
+pub(super) fn set_selected(h: &mut XHost, idx: usize, at: f64) {
+    let items = entries(h, idx);
+    let value = if at.is_finite() && at >= 0.0 { items.get(at as usize).map(|(_, s)| s.clone()).unwrap_or_default() } else { String::new() };
+    h.set_value(idx, value);
+}
diff --git a/crates/js/src/xfa/data.rs b/crates/js/src/xfa/data.rs
new file mode 100644
index 00000000..35b04e35
--- /dev/null
+++ b/crates/js/src/xfa/data.rs
@@ -0,0 +1,408 @@
+//! Data a form's scripts make under `xfa.datasets` (XFA 3.3 chapter 4): groups they create (`createNode("dataGroup",
+//! "LOVFile")`), add (`xfa.datasets.nodes.append`), fill from XML (`loadXML`) and read back (`resolveNodes("xfa.datasets.
+//! LOVFile.LOV.Country[*]")`, `item.lic.value`). Forms keep their lists of values there (an IRCC form loads 500 KiB of them
+//! when it opens). The store is the document's, shared by every script of every event while the form is open; the form's
+//! own data (`xfa.datasets.data`) stays where it is.
+
+use std::sync::{Arc, Mutex};
+
+use boa_engine::property::Attribute;
+use boa_engine::{Context, JsResult, JsString, JsValue, NativeFunction, Source, js_string};
+
+use super::host::host;
+use crate::{arg, function};
+
+/// The most nodes a document's scripts may make.
+pub const MAX_DATA_NODES: usize = 400_000;
+/// The most bytes of names, attributes and text they may keep.
+pub const MAX_DATA_BYTES: usize = 32 << 20;
+/// The longest XML one `loadXML` reads.
+pub const MAX_LOAD_XML: usize = 8 << 20;
+/// Deepest path or XML nesting followed.
+const MAX_DEPTH: usize = 64;
+
+#[derive(Clone, Debug, Default)]
+struct DNode {
+    name: String,
+    group: bool,
+    attrs: Vec<(String, String)>,
+    text: String,
+    children: Vec<usize>,
+    parent: Option<usize>,
+}
+
+/// The nodes; node 0 is `xfa.datasets` itself.
+#[derive(Debug)]
+pub struct DataStore {
+    nodes: Vec<DNode>,
+    bytes: usize,
+}
+
+impl Default for DataStore {
+    fn default() -> Self {
+        DataStore { nodes: vec![DNode { name: "datasets".into(), group: true, ..Default::default() }], bytes: 0 }
+    }
+}
+
+impl DataStore {
+    fn add(&mut self, n: DNode) -> Option<usize> {
+        let size = n.name.len() + n.text.len() + n.attrs.iter().map(|(k, v)| k.len() + v.len()).sum::<usize>();
+        if self.nodes.len() >= MAX_DATA_NODES || self.bytes.saturating_add(size) > MAX_DATA_BYTES {
+            return None;
+        }
+        self.bytes += size;
+        self.nodes.push(n);
+        Some(self.nodes.len() - 1)
+    }
+
+    fn append(&mut self, parent: usize, child: usize) {
+        if parent >= self.nodes.len() || child >= self.nodes.len() || child == 0 || self.is_under(parent, child) {
+            return;
+        }
+        if let Some(old) = self.nodes[child].parent {
+            self.nodes[old].children.retain(|&c| c != child);
+        }
+        self.nodes[child].parent = Some(parent);
+        self.nodes[parent].children.push(child);
+    }
+
+    fn remove(&mut self, parent: usize, child: usize) {
+        if parent < self.nodes.len() && child < self.nodes.len() && self.nodes[child].parent == Some(parent) {
+            self.nodes[parent].children.retain(|&c| c != child);
+            self.nodes[child].parent = None;
+        }
+    }
+
+    /// Whether `node` is `ancestor` or below it.
+    fn is_under(&self, node: usize, ancestor: usize) -> bool {
+        let mut at = Some(node);
+        let mut guard = 0;
+        while let Some(n) = at {
+            if n == ancestor {
+                return true;
+            }
+            guard += 1;
+            if guard > MAX_DEPTH * 4 {
+                return false;
+            }
+            at = self.nodes.get(n).and_then(|d| d.parent);
+        }
+        false
+    }
+
+    fn child(&self, parent: usize, name: &str, nth: usize) -> Option<usize> {
+        self.nodes.get(parent)?.children.iter().copied().filter(|&c| self.nodes[c].name == name).nth(nth)
+    }
+
+    /// `loadXML(xml, ignoreRoot, overwrite)`: the XML's root element (or its children, ignoring the root) under `at`.
+    fn load_xml(&mut self, at: usize, xml: &str, ignore_root: bool, overwrite: bool) -> Result<(), String> {
+        if xml.len() > MAX_LOAD_XML {
+            return Err(format!("loadXML: the XML is longer than {} MiB", MAX_LOAD_XML >> 20));
+        }
+        let doc = roxmltree::Document::parse(xml.trim_start_matches('\u{feff}').trim()).map_err(|e| format!("loadXML: {e}"))?;
+        if overwrite && let Some(n) = self.nodes.get_mut(at) {
+            n.children.clear();
+        }
+        let root = doc.root_element();
+        if ignore_root {
+            for c in root.children().filter(|c| c.is_element()) {
+                self.copy(c, at, 0);
+            }
+        } else {
+            self.copy(root, at, 0);
+        }
+        Ok(())
+    }
+
+    fn copy(&mut self, x: roxmltree::Node, parent: usize, depth: usize) {
+        if depth > MAX_DEPTH {
+            return;
+        }
+        let kids: Vec<roxmltree::Node> = x.children().filter(|c| c.is_element()).collect();
+        let text: String = if kids.is_empty() { x.children().filter(|c| c.is_text()).filter_map(|c| c.text()).collect() } else { String::new() };
+        let attrs = x.attributes().map(|a| (a.name().to_string(), a.value().to_string())).collect();
+        let Some(id) =
+            self.add(DNode { name: x.tag_name().name().to_string(), group: !kids.is_empty(), attrs, text, children: Vec::new(), parent: None })
+        else {
+            return;
+        };
+        self.append(parent, id);
+        for k in kids {
+            self.copy(k, id, depth + 1);
+        }
+    }
+
+    /// The nodes a path names from `from` (`LOVFile.LOV.Country[*]`, `LOVFile`, `a.b[2]`).
+    fn resolve(&self, from: usize, path: &str) -> Vec<usize> {
+        let mut at = vec![from];
+        for (depth, step) in path.split('.').filter(|s| !s.is_empty()).enumerate() {
+            if depth > MAX_DEPTH {
+                return Vec::new();
+            }
+            let (name, index) = match step.split_once('[') {
+                Some((n, rest)) => (n, Some(rest.trim_end_matches(']').trim())),
+                None => (step, None),
+            };
+            let mut next = Vec::new();
+            for &p in &at {
+                let Some(node) = self.nodes.get(p) else { continue };
+                let same: Vec<usize> = node.children.iter().copied().filter(|&c| self.nodes[c].name == name).collect();
+                match index {
+                    Some("*") => next.extend(same),
+                    Some(i) => next.extend(i.parse::<usize>().ok().and_then(|i| same.get(i).copied())),
+                    None => next.extend(same.first().copied()),
+                }
+            }
+            at = next;
+            if at.is_empty() {
+                break;
+            }
+        }
+        at
+    }
+
+    /// The values of the nodes `path` names from the root, for a field's `<bindItems>`: each node's text (`labelRef="$"`) or the
+    /// attribute `labelRef` names, and the same for `valueRef`.
+    pub fn items(&self, path: &str, label: &str, value: &str) -> Vec<(String, String)> {
+        let path = path.trim().strip_prefix("xfa.datasets.").or_else(|| path.trim().strip_prefix("$data.")).unwrap_or(path.trim());
+        let read = |n: usize, r: &str| -> String {
+            let d = &self.nodes[n];
+            match r.trim() {
+                "" | "$" => d.text.clone(),
+                a => d
+                    .attrs
+                    .iter()
+                    .find(|(k, _)| k == a)
+                    .map(|(_, v)| v.clone())
+                    .or_else(|| self.child(n, a, 0).map(|c| self.nodes[c].text.clone()))
+                    .unwrap_or_default(),
+            }
+        };
+        self.resolve(0, path).into_iter().map(|n| (read(n, label), read(n, value))).collect()
+    }
+}
+
+/// The document's store, shared by every script while the form is open. Never compared.
+#[derive(Clone, Default)]
+pub struct SharedData(pub Arc<Mutex<DataStore>>);
+
+impl SharedData {
+    pub fn lock(&self) -> std::sync::MutexGuard<'_, DataStore> {
+        self.0.lock().unwrap_or_else(std::sync::PoisonError::into_inner)
+    }
+}
+
+impl PartialEq for SharedData {
+    fn eq(&self, _: &Self) -> bool {
+        true
+    }
+}
+
+impl std::fmt::Debug for SharedData {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("SharedData")
+    }
+}
+
+fn store(ctx: &mut Context) -> JsResult<SharedData> {
+    Ok(host(ctx)?.borrow().doc.data.clone())
+}
+
+fn id_arg(args: &[JsValue], i: usize, ctx: &mut Context) -> JsResult<usize> {
+    Ok(arg(args, i).to_number(ctx)?.max(0.0) as usize)
+}
+
+fn str_arg(args: &[JsValue], i: usize, ctx: &mut Context) -> JsResult<String> {
+    Ok(arg(args, i).to_string(ctx)?.to_std_string_escaped())
+}
+
+fn n(v: usize) -> JsValue {
+    JsValue::from(v as f64)
+}
+
+fn xd_text(_: &JsValue, a: &[JsValue], ctx: &mut Context) -> JsResult<JsValue> {
+    let id = id_arg(a, 0, ctx)?;
+    let s = store(ctx)?;
+    let t = s.lock().nodes.get(id).map(|d| d.text.clone()).unwrap_or_default();
+    Ok(JsString::from(t.as_str()).into())
+}
+
+fn xd_set_text(_: &JsValue, a: &[JsValue], ctx: &mut Context) -> JsResult<JsValue> {
+    let (id, v) = (id_arg(a, 0, ctx)?, str_arg(a, 1, ctx)?);
+    let s = store(ctx)?;
+    let mut st = s.lock();
+    let old = st.nodes.get(id).map_or(0, |d| d.text.len());
+    if st.bytes.saturating_add(v.len()).saturating_sub(old) <= MAX_DATA_BYTES
+        && let Some(d) = st.nodes.get_mut(id)
+    {
+        d.text = v;
+        st.bytes = st.bytes.saturating_add(st.nodes[id].text.len()).saturating_sub(old);
+    }
+    Ok(JsValue::undefined())
+}
+
+fn xd_name(_: &JsValue, a: &[JsValue], ctx: &mut Context) -> JsResult<JsValue> {
+    let id = id_arg(a, 0, ctx)?;
+    let s = store(ctx)?;
+    let (name, group) = s.lock().nodes.get(id).map(|d| (d.name.clone(), d.group)).unwrap_or_default();
+    Ok(JsString::from(format!("{}|{}", if group { "dataGroup" } else { "dataValue" }, name).as_str()).into())
+}
+
+fn xd_children(_: &JsValue, a: &[JsValue], ctx: &mut Context) -> JsResult<JsValue> {
+    let id = id_arg(a, 0, ctx)?;
+    let s = store(ctx)?;
+    let kids = s.lock().nodes.get(id).map(|d| d.children.clone()).unwrap_or_default();
+    let list: Vec<JsValue> = kids.into_iter().map(n).collect();
+    Ok(boa_engine::object::builtins::JsArray::from_iter(list, ctx).into())
+}
+
+fn xd_parent(_: &JsValue, a: &[JsValue], ctx: &mut Context) -> JsResult<JsValue> {
+    let id = id_arg(a, 0, ctx)?;
+    let s = store(ctx)?;
+    Ok(s.lock().nodes.get(id).and_then(|d| d.parent).map_or(JsValue::from(-1.0), n))
+}
+
+/// `__xd_child(id, name)`: the first child of the name, or -1.
+fn xd_child(_: &JsValue, a: &[JsValue], ctx: &mut Context) -> JsResult<JsValue> {
+    let (id, name) = (id_arg(a, 0, ctx)?, str_arg(a, 1, ctx)?);
+    let s = store(ctx)?;
+    Ok(s.lock().child(id, &name, 0).map_or(JsValue::from(-1.0), n))
+}
+
+/// `__xd_attr(id, name)`: the attribute's value, or `undefined`.
+fn xd_attr(_: &JsValue, a: &[JsValue], ctx: &mut Context) -> JsResult<JsValue> {
+    let (id, name) = (id_arg(a, 0, ctx)?, str_arg(a, 1, ctx)?);
+    let s = store(ctx)?;
