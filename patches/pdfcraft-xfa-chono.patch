+//! Local checks against real forms (not part of the shared suite): set CHONO_IMM to a form's path.
+use std::sync::Arc;
+
+use crate::Session;
+
+#[test]
+#[ignore]
+fn local_ircc() {
+    let Ok(path) = std::env::var("CHONO_IMM") else { return };
+    let bytes = Arc::new(std::fs::read(&path).expect("reads"));
+    let mut s = Session::new();
+    let id = s.open("imm.pdf", None, bytes, None).expect("opens");
+    let o = s.take_js_output(id);
+    eprintln!("OPEN errors {}:", o.errors.len());
+    for e in o.errors.iter().take(12) {
+        eprintln!("  - {}", e.lines().take(4).collect::<Vec<_>>().join(" | "));
+    }
+    let form = &s.get(id).unwrap().form;
+    if let Ok(cos) = pdfcraft_cos::Document::open(s.get(id).unwrap().bytes.clone()) {
+        for f in form.iter().filter(|f| f.name.contains("ValidateButton")) {
+            let som_of = |r| {
+                cos.get(r)
+                    .as_dict()
+                    .and_then(|d| d.get(pdfcraft_xfa::SOM_KEY).map(|v| cos.resolve(v)))
+                    .and_then(|v| v.as_string().map(|t| t.to_text()))
+            };
+            eprintln!("BTN {} field-som {:?} widgets {:?}", f.name, som_of(f.obj), f.widgets.iter().map(|w| som_of(w.obj)).collect::<Vec<_>>());
+        }
+    }
+    if let Ok(cos) = pdfcraft_cos::Document::open(s.get(id).unwrap().bytes.clone())
+        && let Some(tpl) = s.get(id).unwrap().xfa_template.clone().or_else(|| crate::xfa::template(&cos))
+    {
+        let uses = pdfcraft_xfa::page_area_uses(&cos, &tpl);
+        let live = pdfcraft_xfa::form_tree_paged(&tpl, pdfcraft_xfa::data_of(&cos).as_ref(), &pdfcraft_xfa::overrides(&cos), &uses);
+        eprintln!("EVENTS {:?}", live.events.iter().filter(|e| e.activity == "click").map(|e| e.som.clone()).take(6).collect::<Vec<_>>());
+        let mut soms = std::collections::HashSet::new();
+        fn walk(n: &pdfcraft_xfa::FormNode, out: &mut std::collections::HashSet<String>, d: usize) {
+            if d > 60 {
+                return;
+            }
+            out.insert(n.som.clone());
+            for c in &n.children {
+                walk(c, out, d + 1);
+            }
+        }
+        walk(&live.root, &mut soms, 0);
+        let names: Vec<String> = pdfcraft_forms::fields(&cos).into_iter().map(|f| f.name).collect();
+        let hit = names.iter().filter(|n| soms.contains(*n)).count();
+        eprintln!(
+            "NAMES {} matched-as-som {} unmatched {:?}",
+            names.len(),
+            hit,
+            names.iter().filter(|n| !soms.contains(*n)).take(4).collect::<Vec<_>>()
+        );
+        eprintln!("SOM SAMPLE {:?}", soms.iter().filter(|s| s.contains("Validate") || s.contains("Visitor")).take(4).collect::<Vec<_>>());
+    }
+    eprintln!(
+        "TPL {} LAYOUT {} OFF {} WARN {:?}",
+        s.get(id).unwrap().xfa_template.is_some(),
+        s.get(id).unwrap().xfa.is_some(),
+        s.get(id).unwrap().xfa_scripts_off,
+        s.get(id).unwrap().info.warnings.iter().take(3).collect::<Vec<_>>()
+    );
+    eprintln!("BUTTONS {:?}", form.iter().filter(|f| f.name.to_lowercase().contains("valid")).map(|f| (&f.name, &f.kind)).collect::<Vec<_>>());
+    for n in ["PlaceBirthCountry", "VisaType", "LanguageTest", "Country_2", "ProvinceState", "Country"] {
+        if let Some(f) = form.iter().find(|f| f.name == n || f.name.starts_with(n)) {
+            eprintln!("FIELD {} options {} value {:?}", f.name, f.options.len(), f.value);
+        }
+    }
+    for f in s.get(id).unwrap().form.iter().filter(|f| !f.value.is_empty() && f.value.iter().any(|v| !v.is_empty())).take(8) {
+        eprintln!("FILLED {} = {:?}", f.name, f.value);
+    }
+    if let Ok(sets) = std::env::var("CHONO_SET") {
+        // name=on|off|text;name=...
+        for item in sets.split(';').filter(|i| !i.is_empty()) {
+            let (n, v) = item.split_once('=').unwrap_or((item, ""));
+            let value = match v {
+                "on" => crate::FieldValue::Check(true),
+                "off" => crate::FieldValue::Check(false),
+                t => crate::FieldValue::Text(t.into()),
+            };
+            let r = s.apply(id, crate::Edit::SetFieldValue { name: n.into(), value });
+            let o = s.take_js_output(id);
+            eprintln!(
+                "SET {n}={v} -> {:?} errors {:?}",
+                r.err(),
+                o.errors.iter().map(|e| e.lines().next().unwrap_or("").to_string()).collect::<Vec<_>>()
+            );
+        }
+        let form = &s.get(id).unwrap().form;
+        for item in sets.split(';').filter(|i| !i.is_empty()) {
+            let n = item.split_once('=').map_or(item, |(n, _)| n);
+            eprintln!("VALUE {n} = {:?}", form.iter().find(|f| f.name == n).map(|f| f.value.clone()));
+        }
+    }
+    if let Ok(code) = std::env::var("CHONO_JS") {
+        let o = s.run_javascript(id, &code, None).unwrap();
+        eprintln!(
+            "JS result {:?} error {:?} console {:?}",
+            o.result,
+            o.error.as_deref().map(|e| e.lines().next().unwrap_or("").to_string()),
+            o.console
+        );
+    }
+    let click = std::env::var("CHONO_CLICK").unwrap_or_else(|_| "ValidateButton".into());
+    let out = s.run_javascript(id, "", Some(click.as_str())).unwrap();
+    eprintln!("CLICK ALERTS {:?}", out.alerts.iter().map(|a| format!("{a:?}").chars().take(300).collect::<String>()).collect::<Vec<_>>());
+    eprintln!("CLICK error {:?}", out.error.as_deref().map(|e| e.lines().take(6).collect::<Vec<_>>().join(" | ")));
+    let o = s.take_js_output(id);
+    for e in o.errors.iter().take(6) {
+        eprintln!("  - {}", e.lines().take(4).collect::<Vec<_>>().join(" | "));
+    }
+    let bytes = s.get(id).unwrap().bytes.clone();
+    if let Ok(out) = std::env::var("CHONO_OUT") {
+        let _ = std::fs::write(out, bytes.as_slice());
+    }
+    if let Ok(cos) = pdfcraft_cos::Document::open(bytes) {
+        let ov = pdfcraft_xfa::overrides(&cos);
+        let mut by: std::collections::BTreeMap<String, usize> = Default::default();
+        ov.borders.values().for_each(|(c, w)| *by.entry(format!("{c}@{w}")).or_default() += 1);
+        eprintln!("COLORS {by:?}");
+        let mut red = std::collections::BTreeSet::new();
+        let mut all = std::collections::BTreeMap::new();
+        for (_, o) in cos.scan_objects() {
+            let Some(d) = o.as_dict() else { continue };
+            if d.get(b"Subtype").and_then(|v| v.as_name()) != Some(&b"Widget"[..]) {
+                continue;
+            }
+            let mut parts = vec![];
+            let mut cur = Some(o.clone());
+            for _ in 0..20 {
+                let Some(c) = cur.take() else { break };
+                let Some(cd) = c.as_dict() else { break };
+                if let Some(t) = cd.get(b"T").and_then(|t| t.as_string()) {
+                    parts.push(t.to_text());
+                }
+                cur = cd.get(b"Parent").map(|p| cos.resolve(p));
+            }
+            parts.reverse();
+            let name = parts.join(".");
+            let bc = d.get(b"MK").map(|m| cos.resolve(m)).and_then(|mk| {
+                mk.as_dict().and_then(|mk| mk.get(b"BC").and_then(|b| b.as_array()).map(|a| a.iter().filter_map(|v| v.as_f64()).collect::<Vec<_>>()))
+            });
+            if bc.as_ref().is_some_and(|c| c.len() == 3 && c[0] > 0.85 && c[1] < 0.1) {
+                red.insert(name.clone());
+            }
+            all.insert(name, bc);
+        }
+        eprintln!("RED WIDGETS {} {:?}", red.len(), red.iter().take(5).collect::<Vec<_>>());
+        eprintln!(
+            "ALLW {} {:?}",
+            all.len(),
+            all.iter()
+                .filter(|(n, _)| ["AliasNameIndicator", "PCRIndicator", "MaritalStatus", "Citizenship", "Status", "CountryofIssue"]
+                    .iter()
+                    .any(|k| n.starts_with(k)))
+                .collect::<Vec<_>>()
+        );
+        for (k, (c, _)) in ov.borders.iter().filter(|(_, (c, _))| c.contains(", 6, 6")) {
+            if !red.iter().any(|r| r == k || r.starts_with(&format!("{k}."))) {
+                let near: Vec<_> = all.iter().filter(|(n, _)| n.starts_with(k.as_str())).take(2).collect();
+                eprintln!("NORED {k} {c} widgets {near:?}");
+            }
+        }
+        eprintln!("BORDERS {} first {:?} | LISTS {}", ov.borders.len(), ov.borders.iter().next(), ov.items.len());
+    }
+    if std::env::var("CHONO_FILL").is_ok() {
+        fill_rounds(&mut s, id, &click);
+    }
+    let form = &s.get(id).unwrap().form;
+    eprintln!("FLAG {:?}", form.iter().find(|f| f.name.contains("ApplicationValidatedFlag")).map(|f| f.value.clone()));
+    eprintln!("ALERTS {}: {:?}", o.alerts.len(), o.alerts.iter().take(2).collect::<Vec<_>>());
+}
+
+/// Names of fields whose widget border is red now.
+fn red_fields(s: &Session, id: crate::DocId) -> Vec<String> {
+    let Ok(cos) = pdfcraft_cos::Document::open(s.get(id).unwrap().bytes.clone()) else { return vec![] };
+    let mut out = vec![];
+    for f in s.get(id).unwrap().form.iter() {
+        let field = cos.get(f.obj);
+        let mut ws = vec![field.clone()];
+        if let Some(k) = field.as_dict().and_then(|d| d.get(b"Kids")).and_then(|k| k.as_array()) {
+            ws = k.iter().map(|k| cos.resolve(k)).collect();
+        }
+        let red = ws.iter().any(|w| {
+            let mk = w.as_dict().and_then(|d| d.get(b"MK")).map(|m| cos.resolve(m));
+            let bc = mk
+                .as_ref()
+                .and_then(|m| m.as_dict())
+                .and_then(|m| m.get(b"BC"))
+                .and_then(|b| b.as_array())
+                .map(|a| a.iter().filter_map(|v| v.as_f64()).collect::<Vec<_>>());
+            bc.is_some_and(|c| c.len() == 3 && c[0] > 0.85 && c[1] < 0.1)
+        });
+        if red {
+            out.push(f.name.clone());
+        }
+    }
+    out
+}
+
+/// Fill what Validate marks, click again, a few rounds; then report the barcode fields.
+fn fill_rounds(s: &mut Session, id: crate::DocId, click: &str) {
+    use crate::{Edit, FieldValue};
+    use pdfcraft_forms::FieldKind;
+    for round in 0..10 {
+        let red = red_fields(s, id);
+        eprintln!("ROUND {round} red {}: {:?}", red.len(), red.iter().take(40).collect::<Vec<_>>());
+        if red.is_empty() {
+            break;
+        }
+        show_rows(s, id, &red);
+        for n in red {
+            let Some(f) = s.get(id).unwrap().form.iter().find(|f| f.name == n).cloned() else { continue };
+            let l = n.to_ascii_lowercase();
+            let value = match f.kind {
+                FieldKind::Radio | FieldKind::CheckBox => {
+                    FieldValue::Widget(if l.contains("indicator") || l.contains("choice") { 1.min(f.widgets.len().saturating_sub(1)) } else { 0 })
+                }
+                FieldKind::Combo | FieldKind::List => match f.options.iter().find(|(_, e)| !e.trim().is_empty()) {
+                    Some((_, e)) => FieldValue::Choice(vec![e.clone()]),
+                    None => continue,
+                },
+                FieldKind::Text => FieldValue::Text(
+                    if l.contains("year") {
+                        "1980"
+                    } else if l.contains("month") {
+                        "01"
+                    } else if l.contains("day") {
+                        "15"
+                    } else if l.contains("alias") {
+                        "OTHERNAME"
+                    } else if l.starts_with("todate") && l != "todate_6" {
+                        "2020-01-01"
+                    } else if l == "fromdate_6" {
+                        "2027-03-01"
+                    } else if l == "todate_6" {
+                        "2027-03-20"
+                    } else if l.contains("fund") {
+                        "5000"
+                    } else if l.contains("expiry") {
+                        "2031-06-30"
+                    } else if l.contains("issue") {
+                        "2021-06-30"
+                    } else if l.contains("date") || l.contains("from") || l.contains("to") {
+                        "2019-01-01"
+                    } else if l.contains("email") {
+                        "sample@example.com"
+                    } else if l.contains("phone") || l.contains("num") {
+                        "5551234567"
+                    } else if l.contains("postal") {
+                        "090101"
+                    } else {
+                        "SAMPLE"
+                    }
+                    .to_string(),
+                ),
+                _ => continue,
+            };
+            if let Err(e) = s.apply(id, Edit::SetFieldValue { name: n.clone(), value }) {
+                eprintln!("  set {n}: {e}");
+            }
+        }
+        let out = s.run_javascript(id, "", Some(click)).unwrap();
+        if let Some(e) = out.error {
+            eprintln!("  click: {}", e.lines().take(3).collect::<Vec<_>>().join(" | "));
+        }
+        let o = s.take_js_output(id);
+        for e in o.errors.iter().take(3) {
+            eprintln!("  js: {}", e.lines().take(3).collect::<Vec<_>>().join(" | "));
+        }
+        for a in o.alerts.iter().take(2) {
+            eprintln!("  alert: {}", format!("{a:?}").chars().take(300).collect::<String>());
+        }
+    }
+    probe(s, id);
+    let o = s.run_document_actions(id, crate::js::DocumentScriptEvent::WillSave);
+    eprintln!("PRESAVE errors {:?}", o.errors.iter().map(|e| e.lines().take(3).collect::<Vec<_>>().join(" | ")).collect::<Vec<_>>());
+    if let Ok(out) = std::env::var("CHONO_FILLED_OUT") {
+        let _ = std::fs::write(out, s.get(id).unwrap().bytes.as_slice());
+    }
+    let form = &s.get(id).unwrap().form;
+    for f in form.iter().filter(|f| f.name.contains("PaperFormsBarcode")) {
+        eprintln!("BARCODE {} = {:?}", f.name, f.value.iter().map(|v| v.chars().take(80).collect::<String>()).collect::<Vec<_>>());
+    }
+    if let Ok(cos) = pdfcraft_cos::Document::open(s.get(id).unwrap().bytes.clone()) {
+        let ov = pdfcraft_xfa::overrides(&cos);
+        if let Ok(out) = std::env::var("CHONO_FILLED_OUT") {
+            let _ = std::fs::write(out, s.get(id).unwrap().bytes.as_slice());
+        }
+        for (k, v) in ov.borders.iter().filter(|(k, _)| k.contains("PreviousCOR[0].Row2[0].Country") || k.contains("CurrentCOR[0].Row2[0].Country")) {
+            eprintln!("BORDER {k} = {v:?}");
+        }
+        eprintln!("BARCODES PRESENCE {:?}", ov.presence.iter().filter(|(k, _)| k.contains("Barcodes")).collect::<Vec<_>>());
+    }
+}
+
+/// `CHONO_PROBE`: run that JavaScript as a script of the form's root subform and print its console.
+fn probe(s: &Session, id: crate::DocId) {
+    if let Ok(code) = std::env::var("CHONO_PROBE") {
+        let doc = s.get(id).unwrap();
+        if let (Some(tpl), Ok(mut cos)) = (doc.xfa_template.clone(), pdfcraft_cos::Document::open(doc.bytes.clone())) {
+            let mut tpl = (*tpl).clone();
+            tpl.root.scripts.push(pdfcraft_xfa::model::Script { activity: "probe".into(), text: code, formcalc: false });
+            let mut out = crate::js::JsOutput::default();
+            let mut run = crate::xfa::XfaRun {
+                page_count: doc.info.pages.len(),
+                out: &mut out,
+                datasets: None,
+                ran_away: false,
+                highlight: false,
+                time_scale: 4,
+            };
+            let root = format!("{}[0]", tpl.root.common.name.clone().unwrap_or_default());
+            let r = crate::xfa::on_event(&mut cos, &tpl, &root, "probe", &mut run);
+            eprintln!(
+                "PROBE {r:?} console {:?} errors {:?}",
+                out.console,
+                out.errors.iter().map(|e| e.lines().take(2).collect::<Vec<_>>().join(" | ")).collect::<Vec<_>>()
+            );
+        }
+    }
+}
+
+/// The second-row country and status fields among `red`, with their value and SOM.
+fn show_rows(s: &Session, id: crate::DocId, red: &[String]) {
+    for n in red.iter().filter(|n| n.ends_with("_2") && (n.starts_with("Country") || n.starts_with("Status"))) {
+        if let Some(f) = s.get(id).unwrap().form.iter().find(|f| &f.name == n) {
+            eprintln!(
+                "  {n}: {:?} value {:?} hidden {:?} opts {}",
+                f.kind,
+                f.value,
+                f.widgets.iter().map(|w| w.hidden).collect::<Vec<_>>(),
+                f.options.len()
+            );
+            if let Ok(cos) = pdfcraft_cos::Document::open(s.get(id).unwrap().bytes.clone()) {
+                let som = cos
+                    .get(f.obj)
+                    .as_dict()
+                    .and_then(|d| d.get(pdfcraft_xfa::SOM_KEY).map(|v| cos.resolve(v)))
+                    .and_then(|v| v.as_string().map(|t| t.to_text()));
+                eprintln!("  {n} SOM {som:?}");
+            }
+        }
+    }
+    if let Some(f) = s.get(id).unwrap().form.iter().find(|f| f.name == "AliasNameIndicator") {
+        eprintln!(
+            "  RADIO {:?} value {:?} states {:?} opts {:?}",
+            f.kind,
+            f.value,
+            f.widgets.iter().map(|w| w.on_state.clone()).collect::<Vec<_>>(),
+            f.options
+        );
+    }
+}
