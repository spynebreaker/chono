+/// The elements of `<variables>` that hold a named value (XFA 3.3 chapter 10), as opposed to a script object.
+const NAMED_VALUE_TAGS: &[&str] = &["text", "integer", "decimal", "float", "boolean", "date", "time", "dateTime"];
