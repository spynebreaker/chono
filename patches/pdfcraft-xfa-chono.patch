+/// The code of the script object standing for a manifest: `nodes`, its `<ref>`s, each with the SOM expression as `value`.
+pub fn manifest_code(name: &str, refs: &[String]) -> String {
+    let mut code = String::from("// xfa manifest\nvar className = \"manifest\";\nvar name = ");
+    js_string(name, &mut code);
+    code.push_str(";\nvar __refs = [");
+    for (i, r) in refs.iter().enumerate() {
