+/// Every SOM path of the live form (its objects and the objects its scripts belong to).
+fn live_soms(live: &LiveForm) -> HashSet<String> {
+    fn walk(n: &FormNode, out: &mut HashSet<String>, depth: usize) {
+        if depth > 256 || out.len() > pdfcraft_xfa::MAX_FORM_NODES {
+            return;
+        }
+        out.insert(n.som.clone());
+        for c in &n.children {
+            walk(c, out, depth + 1);
+        }
+    }
+    let mut out = HashSet::new();
+    walk(&live.root, &mut out, 0);
+    out.extend(live.events.iter().map(|e| e.som.clone()));
+    out
+}
