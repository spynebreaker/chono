+/// A static form's field with no name of its own (`#field[0]`, as Designer leaves table cells)
+/// has no data node: its value stays in the field when the form is saved and reopened, and the
+/// data around it isn't read as its value (Ontario's forms lost such values on reopening).
+#[test]
+fn an_unnamed_static_field_keeps_its_value_through_a_save() {
+    let bytes = pdfcraft_xfa::fixtures::static_shell("<form1><page1><name>Ada</name><agree>1</agree></page1></form1>");
+    let text = String::from_utf8_lossy(&bytes).replace("/T (name[0])", "/T (#ame[0])");
+    assert_ne!(text.as_bytes(), &bytes[..], "the fixture has the field");
+    let mut s = Session::new().with_clock(|| 1_700_000_000);
+    let id = s.open("unnamed.pdf", None, Arc::new(text.into_bytes()), None).expect("opens");
+    let name = "form1[0].page1[0].#ame[0]";
