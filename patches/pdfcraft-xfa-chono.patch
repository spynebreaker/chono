@@ -0,0 +1,46 @@
+//! A PDF417 barcode field is drawn as bars, not as its text.
+
+use pdfcraft_automation::{Automation, Content};
+use serde_json::json;
+
+const TEMPLATE: &str = r##"<?xml version="1.0" encoding="UTF-8"?>
+<xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/">
+<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
+<subform name="form" layout="tb">
+ <pageSet><pageArea name="front"><contentArea x="0.5in" y="0.5in" w="7.5in" h="10in"/><medium short="8.5in" long="11in"/></pageArea></pageSet>
+ <subform name="page" layout="tb">
+  <field name="code" w="95.25mm" h="50.8mm" access="readOnly">
+   <ui><barcode type="pdf417" errorCorrectionLevel="5" moduleHeight="0.676mm" moduleWidth="0.338mm"/></ui>
+   <value><text>IMM5257|SAMPLE|PERSON|1980-01-01|EC</text></value>
+  </field>
+ </subform>
+</subform>
+</template>
+</xdp:xdp>
+"##;
+
+#[test]
+fn a_pdf417_field_is_drawn_as_bars() {
+    let dir = std::env::temp_dir().join(format!("pdfcraft-barcode-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(dir.join("form.pdf"), pdfcraft_xfa::fixtures::shell(TEMPLATE)).unwrap();
+    let mut a = Automation::new().with_root(&dir).unwrap();
+    let Ok(Some(Content::Json(opened))) = a.call("doc_open", &json!({ "path": "form.pdf" })).map(|mut c| c.pop()) else { panic!("opens") };
+    let doc = opened["doc"].as_u64().unwrap();
+    let (w, h, pixels) = a.render_pixels(doc, 1, 4.0).unwrap();
+    let rgba = pixels.as_ref();
+    let dark = |x: u32, y: u32| rgba.get(((y * w + x) * 4) as usize).is_some_and(|r| *r < 64);
+    // The field: 0.5 in from the page's top left, 95.25 by 50.8 mm (at 4 px a point).
+    let (x0, y0, x1, y1) = (144, 144, 144 + 1080, 144 + 576);
+    let count = (y0..y1.min(h)).flat_map(|y| (x0..x1.min(w)).map(move |x| (x, y))).filter(|&(x, y)| dark(x, y)).count();
+    let area = ((x1 - x0) * (y1 - y0)) as usize;
+    assert!(count > area / 40, "bars cover the field: {count} dark of {area}");
+    // `BARCODE_PNG=<path>` keeps the picture, to check it with a barcode reader.
+    if let Ok(out) = std::env::var("BARCODE_PNG") {
+        let file = std::fs::File::create(out).unwrap();
+        let mut enc = png::Encoder::new(std::io::BufWriter::new(file), w, h);
+        enc.set_color(png::ColorType::Rgba);
+        enc.write_header().unwrap().write_image_data(rgba).unwrap();
+    }
+}
