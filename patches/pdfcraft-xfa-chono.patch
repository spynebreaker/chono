+/// A form that keeps its lists of values as XML in a script object loads them under `xfa.datasets` when it opens
+/// (`createNode`, `nodes.append`, `loadXML`); a choice list bound to them (`<bindItems>`) shows them, and a script fills
+/// another one from them (`resolveNodes`, `clearItems`, `addItem`, `selectedIndex`).
+#[test]
+fn xfa_lists_come_from_data_the_scripts_load() {
+    let template = r##"<?xml version="1.0" encoding="UTF-8"?>
+<xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/">
+<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
+<subform name="form" layout="tb">
+ <pageSet><pageArea name="front"><contentArea x="0.5in" y="0.5in" w="7.5in" h="10in"/><medium short="8.5in" long="11in"/></pageArea></pageSet>
+ <variables>
+  <script name="Lists" contentType="application/x-javascript">&lt;Lists&gt;&lt;CountryList&gt;&lt;Country lic="EC"&gt;Ecuador&lt;/Country&gt;&lt;Country lic="CA"&gt;Canada&lt;/Country&gt;&lt;/CountryList&gt;&lt;/Lists&gt;</script>
+ </variables>
+ <event activity="initialize"><script contentType="application/x-javascript">
+  var n = xfa.datasets.resolveNode("Data");
+  if (n == null) { n = xfa.datasets.createNode("dataGroup", "Data"); xfa.datasets.nodes.append(n); }
+  n.loadXML(Lists.value, 0, 1);
+ </script></event>
+ <subform name="page" layout="tb">
+  <field name="bound" w="2in" h="0.3in"><ui><choiceList/></ui>
+   <bindItems ref="xfa.datasets.Data.Lists.CountryList.Country[*]" labelRef="$" valueRef="lic"/>
+  </field>
+  <field name="filled" w="2in" h="0.3in"><ui><choiceList/></ui>
+   <event activity="initialize"><script contentType="application/x-javascript">
+    var list = xfa.resolveNodes("xfa.datasets.Data.Lists.CountryList.Country[*]");
+    this.clearItems();
+    for (var i = 0; i &lt; list.length; i++) this.addItem(list.item(i).value + "!", list.item(i).lic.value);
+    this.selectedIndex = 1;
+   </script></event>
+  </field>
+ </subform>
+</subform>
+</template>
+</xdp:xdp>
+"##;
+    let bytes = Arc::new(pdfcraft_xfa::fixtures::shell(template));
+    let mut s = Session::new().with_clock(|| 1_700_000_000);
+    let id = s.open("lists.pdf", None, bytes, None).expect("opens");
+    let out = s.take_js_output(id);
+    assert!(out.errors.is_empty(), "{:?}", out.errors);
+    let field = |n: &str| s.get(id).unwrap().form.iter().find(|f| f.name == n).cloned().unwrap_or_else(|| panic!("no field {n}"));
+    let shown = |f: &pdfcraft_forms::Field| f.options.iter().map(|(a, b)| format!("{a}={b}")).collect::<Vec<_>>();
+    let bound = field("bound");
+    assert_eq!(bound.options.len(), 2, "{:?}", bound.options);
+    assert!(shown(&bound).iter().any(|o| o.contains("Ecuador")) && shown(&bound).iter().any(|o| o.contains("EC")), "{:?}", bound.options);
+    let filled = field("filled");
+    assert_eq!(filled.options.len(), 2, "{:?}", filled.options);
+    assert!(shown(&filled).iter().any(|o| o.contains("Canada!")), "{:?}", filled.options);
+    assert_eq!(filled.value, vec!["CA".to_string()]);
+}
