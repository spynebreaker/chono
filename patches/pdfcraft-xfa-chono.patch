+//! Local checks against real forms (not part of the shared suite): set CHONO_IMM to a form's path.
+use std::sync::Arc;
+
+use crate::Session;
+
+#[test]
+#[ignore]
+fn local_ircc() {
+    let Ok(path) = std::env::var("CHONO_IMM") else { return };
+    let bytes = Arc::new(std::fs::read(&path).expect("reads"));
+    let mut s = Session::new();
+    let id = s.open("imm.pdf", None, bytes, None).expect("opens");
+    let o = s.take_js_output(id);
+    eprintln!("OPEN errors {}:", o.errors.len());
+    for e in o.errors.iter().take(12) {
+        eprintln!("  - {}", e.lines().take(4).collect::<Vec<_>>().join(" | "));
+    }
+    let form = &s.get(id).unwrap().form;
+    for n in ["PlaceBirthCountry", "VisaType", "LanguageTest", "Country_2", "ProvinceState", "Country"] {
+        if let Some(f) = form.iter().find(|f| f.name == n || f.name.starts_with(n)) {
+            eprintln!("FIELD {} options {} value {:?}", f.name, f.options.len(), f.value);
+        }
+    }
+    let click = std::env::var("CHONO_CLICK").unwrap_or_else(|_| "ValidateButton".into());
+    let out = s.run_javascript(id, "", Some(click.as_str())).unwrap();
+    eprintln!("CLICK error {:?}", out.error.as_deref().map(|e| e.lines().take(6).collect::<Vec<_>>().join(" | ")));
+    let o = s.take_js_output(id);
+    for e in o.errors.iter().take(6) {
+        eprintln!("  - {}", e.lines().take(4).collect::<Vec<_>>().join(" | "));
+    }
+    let form = &s.get(id).unwrap().form;
+    let bytes = s.get(id).unwrap().bytes.clone();
+    if let Ok(out) = std::env::var("CHONO_OUT") {
+        let _ = std::fs::write(out, bytes.as_slice());
+    }
+    if let Ok(cos) = pdfcraft_cos::Document::open(bytes) {
+        let ov = pdfcraft_xfa::overrides(&cos);
+        let mut by: std::collections::BTreeMap<String, usize> = Default::default();
+        ov.borders.values().for_each(|(c, w)| *by.entry(format!("{c}@{w}")).or_default() += 1);
+        eprintln!("COLORS {by:?}");
+        let mut red = std::collections::BTreeSet::new();
+        let mut all = std::collections::BTreeMap::new();
+        for (_, o) in cos.scan_objects() {
+            let Some(d) = o.as_dict() else { continue };
+            if d.get(b"Subtype").and_then(|v| v.as_name()) != Some(&b"Widget"[..]) {
+                continue;
+            }
+            let mut parts = vec![];
+            let mut cur = Some(o.clone());
+            for _ in 0..20 {
+                let Some(c) = cur.take() else { break };
+                let Some(cd) = c.as_dict() else { break };
+                if let Some(t) = cd.get(b"T").and_then(|t| t.as_string()) {
+                    parts.push(t.to_text());
+                }
+                cur = cd.get(b"Parent").map(|p| cos.resolve(p));
+            }
+            parts.reverse();
+            let name = parts.join(".");
+            let bc = d.get(b"MK").map(|m| cos.resolve(m)).and_then(|mk| {
+                mk.as_dict().and_then(|mk| mk.get(b"BC").and_then(|b| b.as_array()).map(|a| a.iter().filter_map(|v| v.as_f64()).collect::<Vec<_>>()))
+            });
+            if bc.as_ref().is_some_and(|c| c.len() == 3 && c[0] > 0.85 && c[1] < 0.1) {
+                red.insert(name.clone());
+            }
+            all.insert(name, bc);
+        }
+        eprintln!("RED WIDGETS {} {:?}", red.len(), red.iter().take(5).collect::<Vec<_>>());
+        eprintln!(
+            "ALLW {} {:?}",
+            all.len(),
+            all.iter()
+                .filter(|(n, _)| ["AliasNameIndicator", "PCRIndicator", "MaritalStatus", "Citizenship", "Status", "CountryofIssue"]
+                    .iter()
+                    .any(|k| n.starts_with(k)))
+                .collect::<Vec<_>>()
+        );
+        for (k, (c, _)) in ov.borders.iter().filter(|(_, (c, _))| c.contains(", 6, 6")) {
+            if !red.iter().any(|r| r == k || r.starts_with(&format!("{k}."))) {
+                let near: Vec<_> = all.iter().filter(|(n, _)| n.starts_with(k.as_str())).take(2).collect();
+                eprintln!("NORED {k} {c} widgets {near:?}");
+            }
+        }
+        eprintln!("BORDERS {} first {:?} | LISTS {}", ov.borders.len(), ov.borders.iter().next(), ov.items.len());
+    }
+    eprintln!("FLAG {:?}", form.iter().find(|f| f.name.contains("ApplicationValidatedFlag")).map(|f| f.value.clone()));
+    eprintln!("ALERTS {}: {:?}", o.alerts.len(), o.alerts.iter().take(2).collect::<Vec<_>>());
+}
