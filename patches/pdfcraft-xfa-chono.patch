+        Some(e) => match e.attrs.iter_mut().find(|(k, _)| k == "nullTest") {
+            Some((_, old)) => old.clone_from(v),
+            None => e.attrs.push(("nullTest".into(), v.clone())),
+        },
+        None => p.elements.push(crate::model::Prop { tag: "validate".into(), attrs: vec![("nullTest".into(), v.clone())], ..Default::default() }),
+    }
