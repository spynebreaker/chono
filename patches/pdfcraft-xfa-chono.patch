+/// A static XFA form's fields by the SOM path of the template object each is: its name, or, for
+/// an object of a page area, its name without the root subform and the page set
+/// (`form1[0].master[0].frontPage[0].Validate[0]` is `frontPage[0].Validate[0]`, as the live
+/// form names what page areas hold).
+fn static_fields_by_som(doc: &pdfcraft_cos::Document, soms: &HashSet<String>) -> HashMap<String, (String, pdfcraft_cos::ObjRef)> {
+    let mut out = HashMap::new();
+    for (som, field) in pdfcraft_xfa::field_objects_by_som_or_names(doc) {
+        if soms.contains(&som) {
+            out.insert(som, field);
+            continue;
+        }
+        let short = som.splitn(3, '.').nth(2).map(str::to_string);
+        match short {
+            Some(short) if soms.contains(&short) => {
+                out.insert(short, field);
+            }
+            _ => {
+                out.insert(som, field);
+            }
+        }
+    }
+    out
+}
