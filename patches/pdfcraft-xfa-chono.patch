+  <field name="out" w="2in" h="0.3in"><ui><textEdit/></ui></field>
+  <field name="clear" w="1in" h="0.3in"><ui><button/></ui>
+   <event activity="click"><script contentType="application/x-javascript">
+    xfa.datasets.nodes.append(xfa.datasets.createNode("dataGroup", "Extra"));
+    xfa.datasets.nodes.append(xfa.datasets.createNode("dataGroup", "LOVFile"));
+    var oNode = xfa.resolveNode("xfa.datasets");
+    var count = oNode.nodes.length, i = 0;
+    while (i &lt; count) {
+     var n = xfa.datasets.nodes.item(i);
+     if (n.name != "data" &amp;&amp; n.name != "LOVFile") { xfa.datasets.nodes.remove(n); count = count - 1; } else { i = i + 1; }
+    }
+    out.rawValue = count + ":" + xfa.datasets.nodes.item(0).name;
+   </script></event>
