+    /// `BARCODE_TEXT=... BARCODE_PBM=out.pbm`: write the symbol as a picture, to check with a reader.
+    #[test]
+    #[ignore]
+    fn dump_symbol() {
+        let (Ok(t), Ok(out)) = (std::env::var("BARCODE_TEXT"), std::env::var("BARCODE_PBM")) else { return };
+        let s = super::pdf417(&t, 5, 270.0, 144.0, 0.958, 1.916).expect("encodes");
+        let (sx, sy, q) = (3usize, 6usize, 20usize);
+        let (w, h) = (s.width * sx + 2 * q, s.rows * sy + 2 * q);
+        let mut px = vec![b'0'; w * h];
+        for r in 0..s.rows {
+            for c in 0..s.width {
+                if s.modules[r * s.width + c] {
+                    for y in 0..sy {
+                        for x in 0..sx {
+                            px[(q + r * sy + y) * w + q + c * sx + x] = b'1';
+                        }
+                    }
+                }
+            }
+        }
+        let mut text = format!("P1\n{w} {h}\n");
+        for row in px.chunks(w) {
+            text.push_str(std::str::from_utf8(row).unwrap());
+            text.push('\n');
+        }
+        std::fs::write(out, text).unwrap();
+        eprintln!("rows {} width {}", s.rows, s.width);
+    }
+}
