+/// Most of the form's data written for `xfa.data.saveXML()`; past it the rest is left out.
+const MAX_DATA_XML: usize = 8 << 20;
+
+/// `n` and what it holds as XML, appended to `out` (names as they are, text escaped).
+fn data_xml(n: &pdfcraft_xfa::DataNode, out: &mut String, depth: usize) {
+    if depth > 256 || out.len() > MAX_DATA_XML {
+        return;
+    }
+    let esc = |t: &str| t.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;");
+    let name = if n.name.is_empty() { "data" } else { n.name.as_str() };
+    out.push('<');
+    out.push_str(name);
+    if n.children.is_empty() && n.text.is_empty() {
+        out.push_str("/>");
+        return;
+    }
+    out.push('>');
+    out.push_str(&esc(&n.text));
+    for c in &n.children {
+        data_xml(c, out, depth + 1);
+    }
+    out.push_str("</");
+    out.push_str(name);
+    out.push('>');
+}
