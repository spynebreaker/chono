+/// A named value under `<variables>` (`<text name="pressed">false</text>`) is read and set through `value` by the scripts of
+/// its subform and below, and what one click sets is what a later click reads.
+#[test]
+fn xfa_scripts_read_and_set_the_named_values_of_their_subform() {
+    let template = r##"<?xml version="1.0" encoding="UTF-8"?>
+<xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/">
+<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
+<subform name="form" layout="tb">
+ <pageSet><pageArea name="front"><contentArea x="0.5in" y="0.5in" w="7.5in" h="10in"/><medium short="8.5in" long="11in"/></pageArea></pageSet>
+ <variables>
+  <text name="pressed">false</text>
+  <text name="quote">say "hi"\ to Núñez</text>
+  <script name="Check" contentType="application/x-javascript">function state() { return "pressed=" + pressed.value; }</script>
+ </variables>
+ <subform name="page" layout="tb">
+  <field name="start" w="2in" h="0.3in"><ui><textEdit/></ui>
+   <event activity="initialize"><script contentType="application/x-javascript">this.rawValue = pressed.value + "|" + quote.value;</script></event>
+  </field>
+  <field name="out" w="2in" h="0.3in"><ui><textEdit/></ui></field>
+  <field name="press" w="1in" h="0.3in"><ui><button/></ui>
+   <event activity="click"><script contentType="application/x-javascript">pressed.value = "true";</script></event>
+  </field>
+  <field name="show" w="1in" h="0.3in"><ui><button/></ui>
+   <event activity="click"><script contentType="application/x-javascript">out.rawValue = Check.state();</script></event>
+  </field>
+ </subform>
+</subform>
+</template>
+</xdp:xdp>
+"##;
+    let bytes = Arc::new(pdfcraft_xfa::fixtures::shell(template));
+    let mut s = Session::new().with_clock(|| 1_700_000_000);
+    let id = s.open("values.pdf", None, bytes, None).expect("opens");
+    let value = |s: &Session, n: &str| s.get(id).unwrap().form.iter().find(|f| f.name == n).map(|f| f.value.clone()).unwrap_or_else(|| panic!("no field {n}"));
+    assert_eq!(value(&s, "start"), vec!["false|say \"hi\"\\ to Núñez".to_string()]);
+    let before = s.run_javascript(id, "throw new Error('AcroForm fallback ran')", Some("show")).unwrap();
+    assert_eq!(before.error, None, "{before:?}");
+    assert_eq!(value(&s, "out"), vec!["pressed=false".to_string()]);
+    let pressed = s.run_javascript(id, "throw new Error('AcroForm fallback ran')", Some("press")).unwrap();
+    assert_eq!(pressed.error, None, "{pressed:?}");
+    let after = s.run_javascript(id, "throw new Error('AcroForm fallback ran')", Some("show")).unwrap();
+    assert_eq!(after.error, None, "{after:?}");
+    assert_eq!(value(&s, "out"), vec!["pressed=true".to_string()], "the click before set it");
+    let out = s.take_js_output(id);
+    assert!(out.errors.is_empty(), "{:?}", out.errors);
+}
