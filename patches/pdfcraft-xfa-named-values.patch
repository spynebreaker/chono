+
+/// The named values of a form's `<variables>` (`<text name="flag">`) as its scripts last set them, by the SOM of the subform
+/// that declares each and its name: a value one event sets is the one a later event reads, for as long as the form is open,
+/// as in Acrobat. Shared by every copy of the template (a copy with a script's overrides applied keeps reading them), not
+/// saved, and never compared.
+#[derive(Clone, Default)]
+pub struct NamedValues(std::sync::Arc<std::sync::Mutex<std::collections::HashMap<String, String>>>);
+
+/// The most named values kept for one form: a form declares a few dozen.
+const MAX_KEPT_NAMED_VALUES: usize = 4096;
+
+impl NamedValues {
+    fn key(som: Option<&str>, name: &str) -> String {
+        format!("{}|{name}", som.unwrap_or(""))
+    }
+
+    /// The value a script last set, if one did.
+    pub fn get(&self, som: Option<&str>, name: &str) -> Option<String> {
+        self.0.lock().unwrap_or_else(std::sync::PoisonError::into_inner).get(&Self::key(som, name)).cloned()
+    }
+
+    /// Keeps `value` for the named value; past [`MAX_KEPT_NAMED_VALUES`] new names are not kept.
+    pub fn set(&self, som: Option<&str>, name: &str, value: &str) {
+        let mut m = self.0.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        let key = Self::key(som, name);
+        if m.len() < MAX_KEPT_NAMED_VALUES || m.contains_key(&key) {
+            m.insert(key, value.to_string());
+        }
+    }
+}
+
+impl PartialEq for NamedValues {
+    fn eq(&self, _: &Self) -> bool {
+        true
+    }
+}
+
+impl std::fmt::Debug for NamedValues {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NamedValues")
+    }
 }
 
