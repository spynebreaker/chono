+/// The elements of `<variables>` that hold a named value (XFA 3.3 chapter 10), as opposed to a script object.
+const NAMED_VALUE_TAGS: &[&str] = &["text", "integer", "decimal", "float", "boolean", "date", "time", "dateTime"];
+/// Most named values read from one `<variables>`.
+const MAX_NAMED_VALUES: usize = 256;
+/// The longest named value read.
+pub const MAX_NAMED_VALUE_TEXT: usize = 64 << 10;
+
+/// The first line of the code of a script object that stands for a named value ([`named_value_code`]).
+pub const NAMED_VALUE_MARKER: &str = "// xfa named value\n";
+
+/// The code of the script object standing for a named value: its text as `value`, which scripts read and set.
+pub fn named_value_code(value: &str) -> String {
+    let mut code = String::with_capacity(value.len() + 64);
+    code.push_str(NAMED_VALUE_MARKER);
+    code.push_str("var value = \"");
+    for c in value.chars() {
+        match c {
+            '"' => code.push_str("\\\""),
+            '\\' => code.push_str("\\\\"),
+            '\n' => code.push_str("\\n"),
+            '\r' => code.push_str("\\r"),
+            c if (c as u32) < 0x20 || c == '\u{2028}' || c == '\u{2029}' => code.push_str(&format!("\\u{:04x}", c as u32)),
+            c => code.push(c),
+        }
+    }
+    code.push_str("\";\nfunction toString() { return String(value); }\n");
+    code
+}
+
 /// The longest script object read (a form's libraries reach a few hundred KiB).
 pub const MAX_SCRIPT_OBJECT_TEXT: usize = 2 << 20;
 
